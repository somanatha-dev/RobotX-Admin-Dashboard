# RobotX Frontend — environment template. Copy to `Frontend/.env` or `Frontend/.env.local`
# (both gitignored). Vite exposes only VITE_* variables, and bakes them in at build time:
# restart `npm run dev` after a change; a deployment (Vercel) sets them in its dashboard
# and must rebuild to pick them up. See docs/runbooks/environments.md.
# Every value here is compiled into the browser bundle and is therefore public — never put a
# secret in this file (the Mapbox token must be a public `pk.` token).

# Backend REST API and Socket.IO. Local development: the local backend.
# Use `localhost` (not 127.0.0.1) to match the page origin, or the auth cookie is dropped.
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_SOCKET_GLOBAL_KEY=__robotx_socket__

VITE_MAPBOX_TOKEN=<mapbox-token>
VITE_MAPBOX_STYLE_3D=mapbox://styles/mapbox/dark-v11
# Optional: Google sign-in; must match the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
