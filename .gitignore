node_modules/
Backend/node_modules/
Frontend/node_modules/

# Environment files: real values never enter git, at any depth and in any case of the
# directory name. Only templates (*.env.example) and the benchmark profile are tracked.
# See docs/runbooks/environments.md.
.env
.env.*
!.env.example
!Backend/.env.benchmark
# LOCAL secrets live in %USERPROFILE%\robotx-secrets (robotx-local.env, neon-original.env).
# A copy that lands in the repository by mistake must still never be committed.
*.env
dist/
build/
*.log
.DS_Store

# React
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env
frontend/.env.*
frontend/.cache/
frontend/.vite/

# Backend
backend/node_modules/
backend/dist/

# Prisma
backend/prisma/dev.db
backend/prisma/dev.db-journal
backend/prisma/*.db

# Generated Prisma client (optional)
backend/node_modules/.prisma/