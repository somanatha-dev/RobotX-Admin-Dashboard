# ═══════════════════════════════════════════════════════════════════════════
# RobotX Backend — environment template for the LOCAL environment.
#
# Copy to %USERPROFILE%\robotx-secrets\robotx-local.env — OUTSIDE the repository and
# OneDrive, because the real file holds local secrets — and fill in the values.
# Backend/src/config/env.js loads it; a `Backend/.env` in the main checkout would take
# precedence and be synced by OneDrive, so do not create one.
#
# The same code runs in both environments; only these values differ. The two
# environments (LOCAL and the original RobotX Neon) and their rules:
# docs/runbooks/environments.md. The deployment (Render) sets the same names in its
# dashboard — never in a committed file.

# ── Environment identity ──────────────────────────────────────────────────
# LOCAL: the backend refuses to start (exit 78) unless DATABASE_URL and REDIS_URL are
# loopback (src/config/environmentGuard.js). A Neon URL can never be used locally.
ROBOTX_ENV=LOCAL
# ═══════════════════════════════════════════════════════════════════════════

# ── Process ────────────────────────────────────────────────────────────────
# `production` on a deployment; anything else allows any localhost origin (CORS)
# and defaults the auth cookie to non-secure.
NODE_ENV=development
PORT=3000
# 127.0.0.1 = loopback only (local development). Unset = 0.0.0.0 (all interfaces).
HOST=127.0.0.1
# The one browser origin allowed by CORS and Socket.IO, exact (no trailing slash).
FRONTEND_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────
# LOCAL: Docker container robotx-recovered-db, 127.0.0.1:5433, database robotx (a verified
# copy of the original Neon neondb). application_name labels the sessions in pg_stat_activity.
DATABASE_URL=postgresql://robotx_dev:<docker-password>@127.0.0.1:5433/robotx?schema=public&application_name=robotx-local

# ── Redis ──────────────────────────────────────────────────────────────────
# false = in-memory KV, single process. Local development must keep it false.
REDIS_ENABLED=false
REDIS_URL=

# ── Auth ───────────────────────────────────────────────────────────────────
# HMAC key, at least 32 bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<random-64-hex>
# Optional: Google sign-in (the OAuth client must list the frontend origin).
GOOGLE_CLIENT_ID=
# Keep BLANK for the LOCAL copy of Neon: ensureAdminUser upserts this user at every boot and
# would overwrite a copied account's password. Log in with an existing copied account instead.
# (Only an EMPTY database needs them, to create its first SUPER_ADMIN and step-up PIN.)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
DEFAULT_ADMIN_PIN=
# Deployment only (cross-site Vercel → Render): COOKIE_SAMESITE=none, COOKIE_SECURE=true
# COOKIE_SAMESITE=
# COOKIE_SECURE=

# ── Maps ───────────────────────────────────────────────────────────────────
MAPBOX_TOKEN=<mapbox-token>

# ── §23.7 identity store (required by the engine; no defaults) ─────────────
# PRIVACY_IDENTITY_KEY is 32 bytes as 64 hex characters. Each environment has its own;
# rotating either one orphans existing identities.
PRIVACY_SURROGATE_SECRET=<random-secret>
PRIVACY_IDENTITY_KEY=<random-64-hex>

# ── Assignment engine ──────────────────────────────────────────────────────
ENGINE_ENABLED=true
# The shard of the world copied from Neon (its Shard/Region rows are in robotx). Same id as
# the deployment, but the lease row lives in robotx, so the two never contend.
SHARD_ID=rnsit-shard
SHARD_CONSENSUS_REPLICATION=SINGLE_PRIMARY_NO_AUTOMATIC_FAILOVER
# At least 32 bytes; each environment has its own.
COMMAND_SIGNING_KEY=<random-64-hex>
# The six verification thresholds (plain decimals > 0) — the V1 values.
VERIFY_ARRIVAL_RADIUS_M=25
VERIFY_TRACK_MIN_FIX_RATE=10
VERIFY_TRACK_MIN_CORRIDOR_FRACTION=0.8
VERIFY_TRACK_MAX_GAP_SECONDS=10
VERIFY_CORRIDOR_HALF_WIDTH_M=30
VERIFY_MAX_SPEED_MS=8.33
# Unset = no PROBE is sent, so no robot passes the liveness check.
AGENT_PROBE_INTERVAL_MS=2000
AGENT_MTLS_REQUIRED=false

# ── Fleet ──────────────────────────────────────────────────────────────────
ENABLE_VIRTUAL_SIMULATOR=true
V1_DEMONSTRATION_COMPOSITION=true
PHYSICAL_FLEET_ENABLED=false
# Physical fleet: off in local development. A deployment that runs
# physical robots sets both, with a declaration file:
# PHYSICAL_FLEET_ENABLED=true
# PHYSICAL_FLEET_DECLARATION_FILE=<path to physical-fleet.declaration.json>
