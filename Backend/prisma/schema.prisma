generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum RobotStatus {
  IDLE
  ACTIVE
  PAUSED
  OFFLINE
  ERROR
  ISSUES
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum CommandType {
  STOP
  PAUSE
  RETURN
  RESUME
}

enum CommandStatus {
  SENT
  ACK
  FAILED
}

enum EventType {
  INFO
  WARNING
  CRITICAL
}

enum DecisionAction {
  WAIT
  REROUTE
  CANCEL
}

enum LocationType {
  COUNTRY
  STATE
  CITY
  AREA
}

enum Role {
  SUPER_ADMIN
}

//////////////////////////////////////////////////////
// USER (SUPER ADMIN ONLY)
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(SUPER_ADMIN)

  // Set the first time this account signs in with "Continue with Google".
  // Login is keyed off the unique email above, so a Google sign-in with a
  // matching, verified email always resolves to this same row — it never
  // creates a second account.
  googleId  String?  @unique

  pinAuth AdminPinAuth?
  webauthnCredentials WebAuthnCredential[]

  createdAt DateTime @default(now())
}


//////////////////////////////////////////////////////
// 🔐 ADMIN PIN AUTH (SEPARATE TABLE)
//////////////////////////////////////////////////////


model AdminPinAuth {
  id        String   @id @default(uuid())

  pinHash   String

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// 🔐 WEBAUTHN / PASSKEY CREDENTIALS (SERVER-VERIFIED)
//////////////////////////////////////////////////////

model WebAuthnCredential {
  id           String   @id @default(uuid())

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Base64url authenticator credential ID — unique per authenticator.
  credentialId String   @unique

  // Base64url-encoded COSE public key returned at registration; used to
  // verify every subsequent assertion signature. Never a secret by itself.
  publicKey    String

  // Signature counter reported by the authenticator; must be strictly
  // increasing on each successful assertion (replay-clone detection).
  counter      BigInt   @default(0)

  transports   String?
  deviceType   String?
  backedUp     Boolean  @default(false)

  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

//////////////////////////////////////////////////////
// LOCATION (CORE FILTER SYSTEM)
//////////////////////////////////////////////////////

model Location {
  id        String   @id @default(uuid())
  name      String
  type      LocationType

  // Optional stable identifier for clean URLs/APIs.
  // Example: "india", "karnataka", "bengaluru", "rr-nagar"
  slug      String?  @unique

  parentId  String?
  parent    Location? @relation("Hierarchy", fields: [parentId], references: [id])
  children  Location[] @relation("Hierarchy")

  lat       Float?
  lon       Float?

  robots    Robot[]

  @@index([type])
  @@index([parentId])
  @@unique([name, parentId])
}

//////////////////////////////////////////////////////
// ROBOT (REAL-TIME STATE)
//////////////////////////////////////////////////////

model Robot {
  id            String   @id @default(uuid())
  robotId       String   @unique
  name          String?

  //////////////////////////////////////////////////
  // 🔥 REQUIRED (FILTER SYSTEM)
  //////////////////////////////////////////////////

  locationId    String
  location      Location @relation(fields: [locationId], references: [id])

  campusId      String?
  campus        Campus?  @relation(fields: [campusId], references: [id])

  // DTARO: zone assignment + utilization tracking
  zoneId        String?
  zone          Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  utilization   Float?   @default(0)

  status        RobotStatus @default(IDLE)
  battery       Float?

  isOnline      Boolean   @default(false)
  socketId      String?
  lastSeenAt    DateTime?

  // live location (FAST access for dashboard/map)
  lat           Float?
  lon           Float?
  speed         Float?

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  // 🔥 CURRENT TASK (1:1 STRICT)
  currentTaskId String?  @unique
  currentTask   Task?    @relation("CurrentTask", fields: [currentTaskId], references: [id])

  // 🔥 ALL TASK HISTORY (1:N)
  tasks         Task[]   @relation("RobotTasks")

  telemetry     Telemetry[]
  events        Event[]
  commands      Command[]
  decisions     Decision[]

  createdAt     DateTime @default(now())

  //////////////////////////////////////////////////
  // INDEXES (PERFORMANCE)
  //////////////////////////////////////////////////

  @@index([status])
  @@index([isOnline])
  @@index([lastSeenAt])
  @@index([locationId])
  @@index([locationId, isOnline])
  @@index([campusId])
  @@index([zoneId])
  @@index([lat, lon])
}

//////////////////////////////////////////////////////
// ZONE (DTARO: GEOGRAPHIC SUB-AREA)
//////////////////////////////////////////////////////

model Zone {
  id        String   @id @default(uuid())
  name      String   @unique

  minLat    Float
  maxLat    Float
  minLon    Float
  maxLon    Float

  robots    Robot[]
  obstacles ObstacleEvent[]

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// OBSTACLE EVENT (DTARO: ENVIRONMENTAL KNOWLEDGE BASE)
//////////////////////////////////////////////////////

model ObstacleEvent {
  id               String   @id @default(uuid())
  obstacleId       String   @unique

  lat              Float
  lon              Float

  zoneId           String?
  zone             Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  severity         String   @default("MEDIUM")
  reportingRobotId String?

  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([zoneId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// CAMPUS (OPTIONAL: GROUP ROBOTS + TASKS)
//////////////////////////////////////////////////////

model Campus {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String

  centerLat Float
  centerLon Float

  robots    Robot[]

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// TASK SYSTEM
//////////////////////////////////////////////////////

model Task {
  id          String   @id @default(uuid())
  taskId      String   @unique

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  // assigned robot
  robotId     String?
  robot       Robot?   @relation("RobotTasks", fields: [robotId], references: [id], onDelete: SetNull)

  // reverse for currentTask (STRICT 1:1)
  currentFor  Robot?   @relation("CurrentTask")

  //////////////////////////////////////////////////
  // DATA
  //////////////////////////////////////////////////

  pickup      String
  pickupLat   Float
  pickupLon   Float
  drop        String
  dropLat     Float
  dropLon     Float

  distanceMeters Float?

  status      TaskStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?

  events      Event[]
  decisions   Decision[]

  createdAt   DateTime @default(now())

  //////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////

  @@index([robotId])
  @@index([status])
}

//////////////////////////////////////////////////////
// TELEMETRY (HIGH FREQUENCY STREAM)
//////////////////////////////////////////////////////

model Telemetry {
  id        String   @id @default(uuid())

  robotId   String
  robot     Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  lat       Float?
  lon       Float?
  speed     Float?
  battery   Float?

  createdAt DateTime @default(now())

  @@index([robotId, createdAt])
}

//////////////////////////////////////////////////////
// EVENTS (NOTIFICATIONS + LOGS)
//////////////////////////////////////////////////////

model Event {
  id        String   @id @default(uuid())

  robotId   String?
  robot     Robot?   @relation(fields: [robotId], references: [id], onDelete: SetNull)

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])

  type      EventType
  message   String

  createdAt DateTime @default(now())

  @@index([robotId])
  @@index([taskId])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// COMMAND TRACKING (VERY IMPORTANT)
//////////////////////////////////////////////////////

model Command {
  id         String   @id @default(uuid())

  robotId    String
  robot      Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  type       CommandType

  status     CommandStatus @default(SENT)

  issuedAt   DateTime @default(now())
  executedAt DateTime?

  @@index([robotId])
  @@index([issuedAt])
}

//////////////////////////////////////////////////////
// DECISION SYSTEM (YOUR MODAL FEATURE)
//////////////////////////////////////////////////////

model Decision {
  id        String   @id @default(uuid())

  robotId   String
  robot     Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])

  reason    String
  imageUrl  String?

  action    DecisionAction?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([robotId])
  @@index([taskId])
}