DATABASE_URL=postgresql://bench:bench@localhost:5433/robotx_bench?connection_limit=20
REDIS_URL=redis://localhost:6380
REDIS_ENABLED=true
FRONTEND_URL=http://localhost:5173
JWT_SECRET=benchmark-only-secret-not-for-production-0000000000000000
PORT=4100
HOST=127.0.0.1
NODE_ENV=development
SEED_ADMIN_EMAIL=bench-admin@example.com
SEED_ADMIN_PASSWORD=BenchAdmin123!
DISABLE_VIRTUAL_SIMULATOR=true
# Production-realistic logging posture for the validation benchmark — the
# dev-mode logger has no level filtering below this (fixed 2026-07-27), and
# defaults to "debug" otherwise, which would still reproduce the per-tick
# telemetry log volume this run is specifically measuring the removal of.
LOG_LEVEL=info
MAPBOX_TOKEN=pk.eyJ1Ijoic29tYW5hdGhhLWRldiIsImEiOiJjbW5jNXJ2cTMweTlqMnFxdzMyZGdlaXpoIn0.zChXKOb79WuLlgix13vcxA
# Next-generation assignment engine master switch (Phase 0). Default off: the
# engine under src/engine/** is inert until the Phase 15 cutover. The benchmark
# baseline must keep measuring the legacy dispatcher until that gate is passed,
# otherwise the before/after comparison the cutover depends on is invalid.
ENGINE_ENABLED=false


# Agent mutual-TLS posture (Phase 14, §23.2). Off for the benchmark baseline: the
# simulated fleet authenticates by pairing, and requiring certificates would measure
# a handshake the legacy comparison does not contain.
AGENT_MTLS_REQUIRED=false

# PHASE 14 (§23.7) — the identity store's two secrets. Benchmark-only values; the
# benchmark writes and erases synthetic addresses and never sees a real one. See `.env`
# for why neither has a default. Added at the Phase 14 remediation (P14-R7), which made
# the production intake path a writer of `Stop.identityKey` and therefore made both
# variables a hard dependency of any run that submits a task.
PRIVACY_SURROGATE_SECRET=benchmark-surrogate-secret-not-for-production-use
PRIVACY_IDENTITY_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
